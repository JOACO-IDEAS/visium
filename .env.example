# VISIUM environment contract — safe placeholders only.
# Copy to `.env.local` for local development. Never commit real values.

# REQUIRED LOCAL
# None. The web experience, tracked GLB viewer, scoring tests, lint, and build
# work without provider credentials.

# OPTIONAL SERVER-ONLY
# Enables real lead-alert delivery through Resend. Without it, forms either
# return an unavailable response or log a development fallback.
RESEND_API_KEY=

# Server-side destination for lead alerts. This is operational configuration;
# do not expose it through a NEXT_PUBLIC_ variable.
LEAD_ALERT_EMAIL=

# DEPLOYMENT-ONLY / NON-SECRET
# When set to 1 by the canonical demo project, rewrites `/` to `/v2`.
DEMO_ROOT_V2=

# BROWSER-SAFE
# No NEXT_PUBLIC_* variables are currently read by the codebase.
